#!/usr/bin/env ruby

# Prints the release notes of a version of Live as markdown.
#
# The implementation is in the AlsReleaseNotes class, in
# lib/als_release_notes/als_release_notes.rb.

if ENV['VO_DEBUGGING']
  require_relative '../lib/live_set'
else
  require 'live_set'
end

exit AlsReleaseNotes.run(ARGV)
