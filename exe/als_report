#!/usr/bin/env ruby

# Writes a report of a Live set.
#
# The implementation is in the AlsReport class, in lib/als_report/als_report.rb.
#
# To convert a set to another version of the format, use the als_to_version command.

if ENV['VO_DEBUGGING']
  require_relative '../lib/live_set'
else
  require 'live_set'
end

exit AlsReport.run(ARGV)
