#!/usr/bin/env ruby
# frozen_string_literal: true

require 'zlib'
require 'nokogiri'

def help(msg)
  warn msg
  warn "Usage: #{File.basename($0)} ALS_FILE ID"
  exit 1
end

als_file = ARGV[0]
target_id = ARGV[1]

help("Error: No ALS file was specified") unless als_file
help("Error: No device ID was specified") unless target_id
help("Error: File not found: #{als_file}") unless File.exist?(als_file)

xml_content = begin
  Zlib::GzipReader.open(als_file, &:read)
rescue Zlib::GzipFile::Error
  File.read(als_file)
end

doc = Nokogiri::XML(xml_content)

# Search globally across all <Devices> containers to catch top-level and nested rack devices
target_nodes = doc.xpath("//Devices/*[@Id='#{target_id}']")

if target_nodes.empty?
  all_ids = doc.xpath("//Devices/*[@Id]").map { |n| n['Id'].to_i }
  min_id = all_ids.min || 0
  max_id = all_ids.max || 0
  warn "Error: Device ID #{target_id} not found in #{als_file} (Valid device IDs range from #{min_id} to #{max_id})"
  exit 1
end

puts "Found #{target_nodes.length} instance(s) of Device ID #{target_id}:"

target_nodes.each_with_index do |node, idx|
  instance_num = idx + 1

  # Scope to the immediate parent <Devices> container and format XPath to start with //
  container = node.parent
  container_xpath = if container
    "//" + container.path.sub(/^\/+/, '')
  else
    "Unknown Container"
  end

  # Enumerate actual child devices with IDs inside this specific container
  child_devices = container ? container.xpath('./*[@Id]') : []

  # Cleanly format XML by duplicating the node, stripping whitespace-only text nodes,
  # and applying Nokogiri's FORMAT serializer option.
  clean_node = node.dup
  clean_node.xpath('.//text()[normalize-space(.)=""]').remove
  formatted_xml = clean_node.to_xml(
    indent: 2,
    save_with: Nokogiri::XML::Node::SaveOptions::NO_DECLARATION | Nokogiri::XML::Node::SaveOptions::FORMAT
  )

  puts "\n--- Instance #{instance_num} of #{target_nodes.length} ---"
  puts "XPath to parent of device with ID=#{target_id}:"
  puts container_xpath

  puts "\nThe parent has #{child_devices.length} devices:"
  child_devices.each.with_index(1) do |child, child_idx|
    puts "  #{child_idx}. #{child.name} (ID: #{child['Id']})"
  end

  puts "\nThis is device #{node.name} (ID: #{target_id}):"
  puts formatted_xml
end
