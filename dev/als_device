#!/bin/bash

function help {
  cat <<EOF
  $1

  $(basename $0) - Find all devices or a specific device from its ID.

  Usage: $(basename $0) ALS_FILE ID
EOF
  exit 1
}

ALS_FILE="$1"
ID="$2"

# Device Id is NOT globally unique in an Ableton .als XML file.
# Ableton reuses Ids inside every track's Devices list!

if [[ ! "$ALS_FILE" ]]; then help "Error: No ALS file was specified"; fi
if [[ ! "$ID" ]]; then help "Error: No device ID was specified"; fi

echo "XPath to device with ID=10:"
# This does not show the name of the device
als_nodes "$ALS_FILE" \
  "//DeviceChain/DeviceChain/Devices/*[@Id=$ID]/ancestor::*/self::*" --name | \
    jq -r '"//" + join("/")'
als_nodes "$ALS_FILE" \
  "//DeviceChain/DeviceChain/Devices/*[@Id=$ID]"
