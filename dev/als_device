#!/usr/bin/env ruby
# frozen_string_literal: true

require 'zlib'
require 'nokogiri'
require 'optparse'

def help(msg, parser = nil)
  warn msg
  warn parser.help if parser
  exit 1
end

options = { short: false, item: nil }
parser = OptionParser.new do |opts|
  opts.banner = "Find and inspect Ableton Live device instances by ID.\n\nUsage: #{File.basename($0)} [options] ALS_FILE ID"
  opts.on('--short', 'Abbreviate device output to top-level elided elements') do
    options[:short] = true
  end
  opts.on('--item N', Integer, 'Display only the specified instance N (1-based)') do |n|
    options[:item] = n
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption => e
  help(e.message, parser)
end

als_file = ARGV[0]
target_id = ARGV[1]

help("Error: No ALS file was specified", parser) unless als_file
help("Error: No device ID was specified", parser) unless target_id
help("Error: File not found: #{als_file}", parser) unless File.exist?(als_file)

xml_content = begin
  Zlib::GzipReader.open(als_file, &:read)
rescue Zlib::GzipFile::Error
  File.read(als_file)
end

doc = Nokogiri::XML(xml_content)

# Search globally across all <Devices> containers to catch top-level and nested rack devices
target_nodes = doc.xpath("//Devices/*[@Id='#{target_id}']")

if target_nodes.empty?
  all_ids = doc.xpath("//Devices/*[@Id]").map { |n| n['Id'].to_i }
  min_id = all_ids.min || 0
  max_id = all_ids.max || 0
  warn "Error: Device ID #{target_id} not found in #{als_file} (Valid device IDs range from #{min_id} to #{max_id})"
  exit 1
end

total_instances = target_nodes.length

if options[:item]
  if options[:item] < 1 || options[:item] > total_instances
    warn "Error: Item instance #{options[:item]} out of range (1..#{total_instances})"
    exit 1
  end
  selected_indices = [options[:item] - 1]
else
  selected_indices = (0...total_instances).to_a
end

puts "Found #{total_instances} instance(s) of Device ID #{target_id}:"

selected_indices.each do |idx|
  node = target_nodes[idx]
  instance_num = idx + 1

  # Scope to the immediate parent <Devices> container and format XPath to start with //
  container = node.parent
  container_xpath = if container
    "//" + container.path.sub(/^\/+/, '')
  else
    "Unknown Container"
  end

  # Enumerate actual child devices with IDs inside this specific container
  child_devices = container ? container.xpath('./*[@Id]') : []

  # Cleanly format XML by duplicating the node, stripping whitespace-only text nodes
  clean_node = node.dup
  clean_node.xpath('.//text()[normalize-space(.)=""]').remove

  # Abbreviate children if --short is enabled by clearing inner content and setting elided attribute
  if options[:short]
    clean_node.element_children.each do |child|
      if child.children.any?
        child.inner_html = ''
        child['elided'] = 'true'
      end
    end
  end

  formatted_xml = clean_node.to_xml(
    indent: 2,
    save_with: Nokogiri::XML::Node::SaveOptions::NO_DECLARATION | Nokogiri::XML::Node::SaveOptions::FORMAT
  )

  puts "\n--- Instance #{instance_num} of #{total_instances} ---"
  puts "XPath to parent of device with ID=#{target_id}:"
  puts container_xpath

  puts "\nThe parent has #{child_devices.length} devices:"
  child_devices.each.with_index(1) do |child, child_idx|
    puts "  #{child_idx}. #{child.name} (ID: #{child['Id']})"
  end

  puts "\nThis is device #{node.name} (ID: #{target_id}):"
  puts formatted_xml
end
