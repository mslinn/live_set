#!/usr/bin/env ruby

require 'zlib'
require 'nokogiri'
require 'optparse'
require 'colorize'
require 'io/console'
require 'json'

# rubocop:disable-next Style/RedundantStringEscape
HELP_TEXT = <<~HELP.freeze
  als_find: Find and inspect Ableton Live elements by ID, or inspect all instances of a given type.

  Usage: als_find [OPTIONS] [TYPE [ID]] ALS_FILE

  OPTIONS can be placed anywhere on the command line.
      --item N        Display only the specified instance N (1-based)
      --jsonl         Output matches as JSON Lines (one JSON object per line)
      --list          Print a compact summary list of matching elements without XML output
      --name PATTERN  Filter elements by name using a regex (e.g. 'kick' or '/kick|snare/i')
      --no-color      Disable colored terminal output (also respects NO_COLOR env var)
      --short         Abbreviate output to top-level elided elements
      --sortby KEY    Sort results by: id, name (display name), tag (XML tag), xpath, or none
                      (default: none, i.e. order read from file)

  TYPE must be one of: device, track, clip (case insensitive). If TYPE is not specified,
  all instances of all supported types are reported.

  ID must be an integer if specified. If TYPE is not specified, then ID is not permitted.

  ALS_FILE is only read and is not modified.

  Parsing Examples:
  # Pretty-print the first match with syntax highlighting to verify all fields:
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --short --jsonl | \
    jq -C '.' | head -n 40

  # Summarize metadata fields
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --short --jsonl | \
    jq -r '[.id, (.name // "-"), "\(.sibling_index)/\(.sibling_count + 1)", .xpath_parent] | @tsv'

  # Find only top-level rack devices (exclude nested racks inside other AudioEffectGroupDevice
  # or InstrumentGroupDevice chains):
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --short --jsonl | \
    jq 'select(.xpath_parent | contains("Branches") | not)'

  # Find racks that have a custom user/effective name (name != null):
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --short --jsonl | \
    jq 'select(.name != null) | {id, name, xpath}'

  # Find racks containing a specific sibling device (e.g., racks on the same chain as an Eq8):
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --short --jsonl | \
    jq 'select(any(.siblings[]; .tag == "Eq8")) | {id, name, siblings: [.siblings[].tag]}'

  # Extract the XML of the 2nd match and pretty-print with xmllint.
  # BTW, xmllint can also be used to query XML
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --jsonl | \
    jq -r 'select(.index == 2) | .xml' | \
    xmllint --format -

  # Group racks by their custom name and count occurrences
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --short --jsonl | \
    jq -s 'group_by(.name) | map({name: (.[0].name // "Unnamed"), count: length})'

  # Macro knob settings describe the state of the knob itself (its display name and current
  # 0–127 dial value), whereas active parameter mappings describe the wiring underneath;
  # which child device parameters that macro knob actually controls and across what min/max range.

  # Extract macro knob settings
  dev/als_find device "$live12set" --name AudioEffectGroupDevice --jsonl | while IFS= read -r line; do
    rack_name=$(jq -r '.name // "Unnamed Rack"' <<< "$line")
    rack_xpath=$(jq -r '.xpath' <<< "$line")

    macros=$(jq -r '.xml' <<< "$line" | xmlstarlet sel -t \
      -m '/*/*[starts-with(name(), "MacroControls.")]' \
      --var idx='substring-after(name(), "MacroControls.")' \
      --var label='string(/*/*[name()=concat("MacroDisplayNames.", $idx)]/@Value)' \
      --var val='string(./Manual/@Value)' \
      --if '$label != concat("Macro ", number($idx) + 1) or number($val) != 0' \
        -v 'concat("  ", $idx, ": ", $label, " = ", $val)' -n \
      --break)

    if [[ -n "$macros" ]]; then
      echo "=== $rack_name ($rack_xpath) ==="
      echo "$macros"
    fi
  done

  # See als_macros for examples of how to process the JSONL output of this als_find command
HELP

XPATH_PATTERNS = {
  'device' => '//Devices/*[%<pred>s]',
  'track'  => '//Tracks/*[%<pred>s] | ' \
              '//*[self::MidiTrack or self::AudioTrack or self::ReturnTrack or ' \
              'self::MasterTrack][%<pred>s]',
  'clip'   => '//*[self::MidiClip or self::AudioClip or self::MidiArrangementClip or ' \
              'self::AudioArrangementClip][%<pred>s]',
}.freeze

TRACK_TAGS = %w[MidiTrack AudioTrack ReturnTrack MasterTrack].freeze
CLIP_TAGS  = %w[MidiClip AudioClip MidiArrangementClip AudioArrangementClip].freeze
VALID_SORT_KEYS = %w[id name tag xpath none].freeze

def abort_with_help(message)
  warn "Error: #{message}\n\n#{HELP_TEXT}"
  exit 1
end

def build_name_regex(pattern)
  if (match = pattern.match(%r{\A/(.*)/([ixm]*)\z}m))
    body, flag_str = match.captures
    flags = 0
    flags |= Regexp::IGNORECASE if flag_str.include?('i')
    flags |= Regexp::EXTENDED   if flag_str.include?('x')
    flags |= Regexp::MULTILINE  if flag_str.include?('m')
    Regexp.new(body, flags)
  else
    Regexp.new(pattern, Regexp::IGNORECASE)
  end
rescue RegexpError => e
  abort_with_help("Invalid regular expression in --name: #{e.message}")
end

no_color_env = ENV.key?('NO_COLOR') && !ENV['NO_COLOR'].empty?
options = {
  short:      false,
  list:       false,
  jsonl:      false,
  name_regex: nil,
  name_raw:   nil,
  sortby:     'none',
  item:       nil,
  color:      $stdout.tty? && !no_color_env,
}

parser = OptionParser.new do |opts|
  opts.on('--short')    { options[:short] = true }
  opts.on('--list')     { options[:list]  = true }
  opts.on('--jsonl')    { options[:jsonl] = true }
  opts.on('--no-color') { options[:color] = false }
  opts.on('--name PATTERN') do |pat|
    options[:name_raw]   = pat
    options[:name_regex] = build_name_regex(pat)
  end
  opts.on('--sortby KEY') do |key|
    normalized = key.downcase
    abort_with_help("Invalid --sortby '#{key}'. Valid keys: #{VALID_SORT_KEYS.join(', ')}.") unless VALID_SORT_KEYS.include?(normalized)
    options[:sortby] = normalized
  end
  opts.on('--item N', Integer) do |n|
    abort_with_help('--item must be a positive integer.') if n < 1
    options[:item] = n
  end
  opts.on('-h', '--help') do
    puts HELP_TEXT
    exit 0
  end
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort_with_help(e.message)
end

String.disable_colorization = !options[:color] || options[:jsonl]

case ARGV.size
when 1
  element_type = nil
  target_id    = nil
  als_file     = ARGV.at(0)
when 2
  element_type = ARGV.at(0).downcase
  target_id    = nil
  als_file     = ARGV.at(1)
when 3
  element_type = ARGV.at(0).downcase
  target_id    = ARGV.at(1)
  als_file     = ARGV.at(2)
else
  abort_with_help('Expected [TYPE [ID]] ALS_FILE (1 to 3 positional arguments).')
end

abort_with_help("Invalid TYPE '#{ARGV.at(0)}'.") if element_type && !XPATH_PATTERNS.key?(element_type)

abort_with_help('ID must be a non-negative integer.') if target_id && !target_id.match?(/\A\d+\z/)

abort_with_help("ALS_FILE '#{als_file}' not found.") unless File.file?(als_file)

xml_content = begin
  Zlib::GzipReader.open(als_file, &:read)
rescue Zlib::GzipFile::Error
  File.read(als_file)
end

# NOBLANKS strips formatting whitespace at the C-parser level, saving memory and cleanup time.
# HUGE prevents libxml2 from aborting on large Ableton Live sets (>10MB uncompressed).
doc = Nokogiri::XML(xml_content) do |config|
  config.noblanks.huge
end

def explicit_display_name(node)
  paths = %w[./Name/EffectiveName ./Name/UserName ./Name ./UserName ./PluginDesc/Name]
  paths.each do |path|
    val = node.at_xpath(path)&.attr('Value')
    return val if val && !val.empty?
  end
  nil
end

def raw_display_name(node)
  explicit_display_name(node) || node.name
end

def infer_element_type(node)
  return 'device' if node.parent&.name == 'Devices'
  return 'track'  if node.parent&.name == 'Tracks' || TRACK_TAGS.include?(node.name)
  return 'clip'   if CLIP_TAGS.include?(node.name)

  'unknown'
end

def node_xpath(node)
  "//#{node.path.sub(%r{\A/+}, '')}"
end

def natural_xpath_key(xpath)
  xpath.split(/(\d+)/).map { |part| part.match?(/\A\d+\z/) ? part.to_i : part }
end

def sort_nodes(nodes, sortby)
  case sortby
  when 'id'
    nodes.sort_by { |n| n['Id'].to_i }
  when 'name'
    nodes.sort_by { |n| [(explicit_display_name(n) || '').downcase, n.name.downcase, n['Id'].to_i] }
  when 'tag'
    nodes.sort_by { |n| [n.name.downcase, n['Id'].to_i] }
  when 'xpath'
    nodes.sort_by.with_index do |n, idx|
      parent_xpath = n.parent ? node_xpath(n.parent) : ''
      [natural_xpath_key(parent_xpath), idx]
    end
  else
    nodes
  end
end

predicate = target_id ? "@Id='#{target_id}'" : '@Id'
patterns  = element_type ? [XPATH_PATTERNS[element_type]] : XPATH_PATTERNS.values
query     = patterns.map { |pat| format(pat, pred: predicate) }.join(' | ')

target_nodes = doc.xpath(query).to_a

if options[:name_regex]
  regex = options[:name_regex]
  target_nodes.select! { |node| raw_display_name(node).match?(regex) }
end

target_nodes = sort_nodes(target_nodes, options[:sortby])

scope_desc = if element_type && target_id
               "#{element_type} ID #{target_id}"
             elsif element_type
               "type '#{element_type}'"
             else
               'all supported types'
             end
scope_desc += " matching '#{options[:name_raw]}'" if options[:name_raw]

if target_nodes.empty?
  range_hint = if target_id && !options[:name_raw]
                 min_id, max_id = doc.xpath('//@Id').lazy.map { |a| a.value.to_i }.minmax
                 " (Valid IDs range from #{min_id || 0} to #{max_id || 0})"
               else
                 ''
               end
  warn "Error: No elements found for #{scope_desc} in #{als_file}#{range_hint}"
  exit 1
end

total_instances = target_nodes.length

selected_indices = if options[:item]
                     if options[:item] > total_instances
                       warn "Error: Item instance #{options[:item]} out of range " \
                            "(1..#{total_instances})"
                       exit 1
                     end
                     [options[:item] - 1]
                   else
                     (0...total_instances)
                   end

def format_display_node(node, short)
  display_node = if short
                   node.dup.tap do |copy|
                     copy.element_children.each do |child|
                       next if child.children.empty?

                       child.children.remove
                       child['elided'] = 'true'
                     end
                   end
                 else
                   node
                 end

  save_opts = Nokogiri::XML::Node::SaveOptions::NO_DECLARATION |
              Nokogiri::XML::Node::SaveOptions::FORMAT
  display_node.to_xml(indent: 2, save_with: save_opts)
end

def terminal_width
  cols = $stdout.tty? ? IO.console&.winsize&.last : nil
  cols&.positive? ? cols : 120
end

def build_list_row(node, instance_num)
  container = node.parent
  container_xpath = container ? node_xpath(container) : 'Unknown Container'
  explicit = explicit_display_name(node)
  name_col = explicit ? "\"#{explicit}\"" : ''

  plain = format('  %3d %-24s %-5s %-24s %s',
                 instance_num, node.name, node['Id'], name_col, container_xpath)
  num_str = format('%3d', instance_num).cyan
  colored = format('  %s %-24s %-5s %-24s %s',
                   num_str, node.name, node['Id'], name_col, container_xpath)

  [plain.length, colored]
end

def render_list(target_nodes, selected_indices)
  rows = selected_indices.map { |idx| build_list_row(target_nodes.at(idx), idx + 1) }
  raw_header = format('  %3s %-24s %-5s %-24s %s', '#', 'tag', 'id', 'name', 'xpath')
  max_row_width = rows.map(&:first).max || raw_header.length
  target_width = [[max_row_width, raw_header.length].max, terminal_width].min

  puts raw_header.ljust(target_width).colorize(color: :black, background: :yellow)
  rows.each { |(_, colored)| puts colored }
end

def render_jsonl_item(node, instance_num, total_instances, als_file, options)
  container = node.parent
  child_elements = container ? container.xpath('./*[@Id]').to_a : []
  self_pos = child_elements.index(node)

  record = {
    'file'          => als_file,
    'id'            => node['Id'].to_i,
    'index'         => instance_num,
    'name'          => explicit_display_name(node),
    'sibling_count' => [child_elements.length - 1, 0].max,
    'sibling_index' => self_pos ? self_pos + 1 : nil,
    'tag'           => node.name,
    'total'         => total_instances,
    'type'          => infer_element_type(node),
    'xpath'         => node_xpath(node),
    'xpath_parent'  => container ? node_xpath(container) : nil,
  }
  unless options[:list]
    record['siblings'] = child_elements.map { |c| { 'id' => c['Id'].to_i, 'tag' => c.name } }
    record['xml'] = format_display_node(node, options[:short])
  end
  puts JSON.generate(record.sort.to_h)
end

def render_instance(node, instance_num, total_instances, short: false)
  container = node.parent
  container_xpath = container ? node_xpath(container) : 'Unknown Container'
  child_elements = container ? container.xpath('./*[@Id]') : []
  sibling_count = [child_elements.length - 1, 0].max
  formatted_xml = format_display_node(node, short)
  puts <<~OUTPUT
    --- Instance #{instance_num} of #{total_instances} ---
    XPath to parent container:
    #{container_xpath}
    This #{node.name} (ID: #{node['Id']}) has #{sibling_count} sibling elements:
  OUTPUT
  child_elements.each.with_index(1) do |child, idx|
    line = "#{idx}. #{child.name} ID: #{child['Id']}"
    line = line.colorize(color: :light_white, background: :green) if child == node
    puts "  #{line}"
  end
  puts "\n#{formatted_xml}"
end
if options[:jsonl]
  selected_indices.each do |idx|
    render_jsonl_item(target_nodes.at(idx), idx + 1, total_instances, als_file, options)
  end
elsif options[:list]
  puts "Found #{total_instances} instance(s) of #{scope_desc}:"
  render_list(target_nodes, selected_indices)
else
  puts "Found #{total_instances} instance(s) of #{scope_desc}:"
  selected_indices.each do |idx|
    render_instance(target_nodes.at(idx), idx + 1, total_instances, short: options[:short])
  end
end
